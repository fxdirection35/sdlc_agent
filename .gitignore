# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Frontend (frontend/dist is already covered by the dist/ pattern above)
node_modules/

# Test / coverage
.pytest_cache/
.pytest-tmp/
# pytest's basetemp when the system temp dir is not writable (see
# tests/conftest.py); listed so it can never be committed by accident again.
pytest-of-*/
.coverage
htmlcov/
.tox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Environment & secrets
.env
.env.*

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
config.yaml
# Local project status notes, deliberately out of git (user's call,
# 2026-10-14); everything else under docs/ stays tracked.
docs/STATUS.md
